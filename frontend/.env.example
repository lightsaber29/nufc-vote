# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local auth testing
# Set to true only when you want cookie-based mock auth locally.
NEXT_PUBLIC_ENABLE_DEV_MOCK_AUTH=false

# Analytics (optional)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Admin
ADMIN_EMAILS=your-email@gmail.com

# Cache revalidation
REVALIDATE_SECRET=

# AI (Gemini) — 예측 화면 참고 문구. 없으면 문구 카드가 빠질 뿐 기능은 동작한다.
GEMINI_API_KEY=
